{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "atlas",
  "version": "0.3.4",
  "identifier": "com.atlas.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atlas SSH Client",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "dialog": false,
      "endpoints": [
        "https://github.com/aleynatila/atlas-shell/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0NjQxRUMzNjRDOEE4Q0EKUldUS3FNaGt3eDVrOUdBczVzUjJ4aWdvMFVRb3JGSGRpaGhCclVzdUtWc09EUlIrbExyY1pLU3MK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
