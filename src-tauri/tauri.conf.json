{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "atlas",
    "version": "0.2.2"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "windows": [
      {
        "title": "Atlas SSH Client",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "fileDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/aleynatila/atlas-shell/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0NjQxRUMzNjRDOEE4Q0EKUldUS3FNaGt3eDVrOUdBczVzUjJ4aWdvMFVRb3JGSGRpaGhCclVzdUtWc09EUlIrbExyY1pLU3MK",
      "windows": {
        "installMode": "passive"
      }
    },
    "bundle": {
      "active": true,
      "targets": ["nsis", "updater"],
      "identifier": "com.atlas.app",
      "icon": ["icons/icon.ico"]
    }
  }
}
