{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "atlas",
  "version": "0.4.8",
  "identifier": "com.atlas.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atlas SSH Client",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src blob: 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "dialog": false,
      "endpoints": [
        "https://github.com/aleynatila/atlas-shell/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1RjcxQjA5QjE3NzM0RkYKUldUL05IZXhDUnYzMVN4b1pHdW1meUd5RmRld0o5WitvUE9HeW9nQSticmlrRVlwMFBrY2dseTAK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
